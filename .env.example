# Example environment file for Docker
# Copy this to .env and fill in your actual values

# OpenRouter API Configuration
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
OPEN_ROUTER_API_URL=https://openrouter.ai/api/v1

# PostgreSQL Configuration
DATABASE_URL=postgresql://raganything:raganything@localhost:5432/raganything

# Set to 0 when using a connection pooler (Neon, PgBouncer, etc.)
# Leave commented to use asyncpg default (100)
# POSTGRES_STATEMENT_CACHE_SIZE=0

# Model Configuration
CHAT_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
MAX_TOKEN_SIZE=8192
VISION_MODEL=openai/gpt-4o

# Kreuzberg Extraction Configuration
KREUZBERG_OCR_MODE=vlm      # Options: 'vlm' (vision LLM via OpenRouter) or 'tesseract' (local OCR)
KREUZBERG_EXTRACTION_TIMEOUT=120   # Timeout extraction Kreuzberg en secondes
KREUZBERG_EXTRACT_IMAGES=false     # Extraire les images embarquées des PDF (coûteux CPU)
KREUZBERG_ENABLE_QUALITY_PROCESSING=false  # Retraite qualité locale (coûteux CPU)
KREUZBERG_VLM_TIMEOUT=60                   # Timeout par appel OCR VLM (par image/page)

# BM25 Configuration
BM25_ENABLED=true
BM25_TEXT_CONFIG=french
BM25_RRF_K=60

# Classical RAG Configuration
CLASSICAL_CHUNK_SIZE=1000
CLASSICAL_CHUNK_OVERLAP=200
CLASSICAL_NUM_QUERY_VARIATIONS=3
CLASSICAL_RELEVANCE_THRESHOLD=5.0
CLASSICAL_TABLE_PREFIX=classical_rag_
CLASSICAL_LLM_TEMPERATURE=0.0

# Server Configuration
MCP_TRANSPORT=sse
ALLOWED_ORIGINS=["*"]
HOST=0.0.0.0
PORT=8000

# MinIO Configuration
MINIO_HOST=localhost:9000
MINIO_ACCESS=minioadmin
MINIO_SECRET=minioadmin
MINIO_BUCKET=raganything
MINIO_SECURE=false

# Bricks API Configuration
BRICKS_API_BASE_URL=https://analyse.bricks.co
BRICKS_API_KEY=
BRICKS_BEARER_TOKEN=
BRICKS_PUBLISH_DRY_RUN=true
BRICKS_HTTP_TIMEOUT=30             # Timeout appels HTTP Bricks en secondes

# API Key Security
# Set a non-empty value to enable API key authentication on REST and MCP endpoints.
# Clients must send this value in the X-API-Key header.
API_KEY=

# Web search & memory tools (built-in MCP servers /web/mcp and /memories/mcp)
# All limits are process-local (per Uvicorn worker); they never coordinate
# across workers or replicas. There is deliberately NO character/output-size
# setting: complete Crawl4AI Markdown is always returned.
WEB_SEARCH_EXECUTOR_WORKERS=4          # DDGS dedicated executor workers (>= 1)
WEB_SEARCH_MAX_CONCURRENCY=4           # max DDGS calls in flight (>= 1)
WEB_SEARCH_TIMEOUT_SECONDS=10          # outer search timeout (finite, > 0)
CRAWL_MAX_CONCURRENT_BATCHES=2         # process-wide crawl batch ceiling (>= 1)
CRAWL_MAX_SESSIONS_PER_BATCH=2         # pages per batch (dispatcher permit)
CRAWL_MEMORY_THRESHOLD_PERCENT=80      # dispatcher memory threshold percent
CRAWL_PAGE_TIMEOUT_SECONDS=20          # finite per-page timeout
CRAWL_OVERALL_TIMEOUT_SECONDS=45       # whole exploration deadline (kept < 60s MCP tool timeout)
CRAWL_RATE_LIMIT_MIN_DELAY_SECONDS=1   # shared rate limiter min base delay
CRAWL_RATE_LIMIT_MAX_DELAY_SECONDS=2   # shared rate limiter max base delay
COMPOSABLE_AGENTS_BASE_URL=http://composable-agents:8000   # Store File API base URL (scheme+host only, no path)
MEMORY_STORE_TIMEOUT_SECONDS=15        # Store File API request timeout

# Dual auth (JWT + per-user API keys)
# LOGTO_URL: base URL of the Logto IdP instance. The JWKS endpoint is derived
# as {LOGTO_URL}/oidc/jwks. When empty, JWT verification is disabled and only
# per-user API keys (read from the shared api_keys table owned by
# composable-agents) are accepted.
LOGTO_URL=
# JWT_AUDIENCE: expected JWT `aud` claim. When empty, no audience check is
# performed.
JWT_AUDIENCE=
# JWT_AUDIENCES: ADDITIONAL expected JWT `aud` claims, comma-separated
# (e.g. the Logto OpenCode app-id). Merged with the legacy JWT_AUDIENCE.
# MUST stay a plain comma-separated list — a JSON-style value is refused at startup.
# JWT_AUDIENCES=

# MCP OAuth2 discovery + transport security (feat-mcp-oauth2-dual-auth)
# MCP_ALLOWED_HOSTS: transport-security Host allow-list, comma-separated
# (REQ-014). DNS-rebinding protection stays ENABLED — a still-foreign Host
# answers 421. Must list the public proxy host in production plus the
# loopback defaults. A present-but-empty value refuses startup.
# MCP_ALLOWED_HOSTS=raganything.soludev.tech,127.0.0.1:*,localhost:*,[::1]:*
# MCP_ALLOWED_ORIGINS: transport-security Origin allow-list, comma-separated
# (M-1). Unset/empty → inherits ALLOWED_ORIGINS; a '*' entry mirrors the CORS
# wildcard (the Origin is not validated); other entries are matched EXACTLY
# by the mcp SDK (an 'origin:*' port wildcard is also honoured).
# MCP_ALLOWED_ORIGINS=https://composable-ui.soludev.tech
# MCP_PUBLIC_BASE_URL: public origin advertised by the OAuth2 discovery
# documents (401 challenge + /.well-known/oauth-protected-resource). When set
# it ALWAYS wins over the request Host (the Host header is never echoed
# unvalidated). MUST be an ABSOLUTE http(s) URL — a scheme-less value REFUSES
# startup; an http:// value is accepted for dev/QA but WARNED at startup. The
# production configmap sets it.
# MCP_PUBLIC_BASE_URL=https://raganything.soludev.tech
# MCP_AUTHORIZATION_SERVER: explicit publicly-reachable authorization-server
# issuer advertised by the protected-resource metadata. MUST be an ABSOLUTE
# http(s) URL when present (a relative value refuses startup). Falls back to
# <LOGTO_URL>/oidc when unset — RESOLVED ONCE at startup by the AppConfig
# model validator (an internal/non-https fallback is WARNED like an explicit
# http:// value); the list is empty when both are unset.
# MCP_AUTHORIZATION_SERVER=https://logto.soludev.tech/oidc
# FORWARDED_ALLOW_IPS: uvicorn honours X-Forwarded-Proto (proxy headers) from
# these trusted proxy IPs only (default 127.0.0.1). Set it to the ingress /
# Traefik pod network in production so no http:// scheme can ever be
# generated behind the TLS-terminating proxy.
# FORWARDED_ALLOW_IPS=127.0.0.1

# === Temporary-file MCP tools (chat-pdf-attachments spec) ===
# FILES_MAX_UPLOAD_SIZE: maximum decoded size (bytes) accepted by the
# temporary_upload_file MCP tool (default 52428800 = 50 MiB).
# FILES_MAX_UPLOAD_SIZE=52428800
